# 백엔드 API 주소 (로컬: http://localhost:8080, 배포: Render 백엔드 URL)
VITE_API_BASE_URL=http://localhost:8080

# 구글 계정 연동/로그인 - Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID (공개 가능한 값, 시크릿 아님)
VITE_GOOGLE_CLIENT_ID=

# AI 챗봇 서버 주소 (Spring과 다른 서버다). Cloud Run 배포 후 받는 주소를 넣는다.
# **비워두면 챗봇 UI가 자동으로 숨겨진다** - 베타를 끄고 싶으면 이 값을 지우면 된다.
# 로컬: http://localhost:8000
VITE_AI_API_BASE_URL=
